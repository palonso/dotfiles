# % ============================ %
# PATH: mise-managed user-space tools (fzf, lazygit, starship, nvim, ...)
# The shims dir is a plain folder of executables, so tools resolve even in
# non-interactive shells; `mise activate` adds per-directory version switching
# for this interactive session.
# % ============================ %
export PATH="$HOME/.local/bin:$HOME/.local/share/mise/shims:$PATH"
command -v mise >/dev/null && eval "$(mise activate zsh)"

# % ============================ %
# Fzf configuration (mise-provided fzf, fall back to legacy ~/.fzf.zsh)
# % ============================ %
if command -v fzf >/dev/null; then
  source <(fzf --zsh)
elif [ -f ~/.fzf.zsh ]; then
  source ~/.fzf.zsh
fi

# % ============================ %
# Prompt configuration
# % ============================ %
command -v starship >/dev/null && eval "$(starship init zsh)"

# Emacs shortcuts for command-line navigation
# This inconsistency is annoying but vim keymaps are unusable in zsh
bindkey -e

# % ============================ %
# Autosuggestions and highlighting
# Prefer brew paths on macOS; fall back to install.sh's git clones under
# ~/.local/share/zsh (used inside containers / Linux without brew).
# % ============================ %
for _zsh_prefix in "$(command -v brew >/dev/null && brew --prefix)/share" "$HOME/.local/share/zsh"; do
  [ -f "$_zsh_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh" ] && \
    source "$_zsh_prefix/zsh-autosuggestions/zsh-autosuggestions.zsh"
  [ -f "$_zsh_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh" ] && \
    source "$_zsh_prefix/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh"
done
unset _zsh_prefix

# % ============================ %
# Aliases
# % ============================ %
alias v=nvim
alias l="ls -lth --color=always"
alias cc="claude"  # Claude Code I guess??
alias c="clear"  # I use this one much more often

alias cnotes="cd $OBSIDIAN_WORKSPACE_PATH"
alias vnotes="cnotes && nvim"

alias cdot="cd $HOME/reps/dotfiles/"
alias vdot="cdot && nvim"

alias creps="cd $HOME/reps/"

# % ============================ %
# Environment variables
# % ============================ %
export EDITOR=nvim

# % ============================ %
# Load private config
# % ============================ %
[ -f "$HOME/.zshrc.secrets" ] && source "$HOME/.zshrc.secrets"
